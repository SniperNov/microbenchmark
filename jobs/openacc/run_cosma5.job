#!/bin/bash -l
#SBATCH -J cosma5_openacc
#SBATCH -o result/COSMA5_Output/Logs/%x_%j.out
#SBATCH -p mi300x
#SBATCH -A do018
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=96
#SBATCH --gres=gpu:1
#SBATCH --exclusive
#SBATCH -t 04:00:00

set -e

cd /cosma/home/do018/dc-tu2/microbenchmark

export PATH="$HOME/bin:$PATH"

module purge

mkdir -p result/COSMA5_Output/Logs
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/../common.sh"

MACHINE="MI300X"
API="OpenACC"
COMPILER_TAG=$(compiler_tag_gcc)
OUTDIR="result/$MACHINE/$API/$COMPILER_TAG"
mkdir -p "$OUTDIR"

JOB_NAME="cosma5_openacc"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="$OUTDIR/${JOB_NAME}_${TIMESTAMP}.out"

GANGS=304
WORKERS=64

N_DATA="1,4,16,64,256,1024,4096,16384,65536,262144,1048576,4194304,16777216"
N_ATORED="1,2,4,8,16,32,64"
N_FIXED="16384"
N_PARREPS="1,2,4,8,16,32,64,128"

DELAY_SHORT="1,8096"
PLOT_PY="${PLOT_PY:-/cosma/home/do018/dc-tu2/microbenchmark/.venv/bin/python}"

echo "Running COSMA5 MI300X OpenACC benchmark groups..." | tee "$OUTFILE"
echo "This is an exploratory OpenACC script; adjust modules/compiler if COSMA uses a different OpenACC toolchain." | tee -a "$OUTFILE"
echo "GANGS=$GANGS WORKERS=$WORKERS" | tee -a "$OUTFILE"

echo "Compiling OpenACC backend..." | tee -a "$OUTFILE"
make clean
make openacc-distribution OPENACC_DEFS=Makefile.defs.openacc.gcc

plot_group () {
    local BASE="$1"
    local CSV="$OUTDIR/distribution_${BASE}.csv"
    local TXT="$OUTDIR/overhead_${BASE}.txt"
    local PNG="$OUTDIR/resultLowest_${BASE}.png"

    if [ -f "$CSV" ] && [ -f "$TXT" ] && [ -x "$PLOT_PY" ]; then
        "$PLOT_PY" ./plots/plot_raw_times.py "$CSV" "$TXT" 1,18 lin "$PNG" 2>&1 | tee -a "$OUTFILE"
    else
        echo "Plot skipped for $BASE." | tee -a "$OUTFILE"
    fi
}

run_group () {
    local TAG="$1"
    local METHODS="$2"
    local NLIST="$3"
    local DELAY_RANGE="$4"

    local SAFE_DELAY="${DELAY_RANGE//,/to}"
    local BASE="${TAG}_${SAFE_DELAY}_${TIMESTAMP}"

    echo "" | tee -a "$OUTFILE"
    echo "===== [$TAG] Method=$METHODS N=$NLIST Delay=$DELAY_RANGE =====" | tee -a "$OUTFILE"

    rm -f overhead_distribution.txt raw_times.csv

    srun ./bin/microbenchmark API=openacc \
        Method="$METHODS" \
        N="$NLIST" \
        Delay="$DELAY_RANGE" \
        gang_count="$GANGS" \
        worker_count="$WORKERS" \
        | tee -a "$OUTFILE"

    if [ -f overhead_distribution.txt ]; then
        mv overhead_distribution.txt "$OUTDIR/overhead_${BASE}.txt"
    fi

    if [ -f raw_times.csv ]; then
        mv raw_times.csv "$OUTDIR/distribution_${BASE}.csv"
    fi

    plot_group "$BASE"
}

run_group "M0_M10" "0,10" "$N_FIXED" "$DELAY_SHORT"
run_group "M1to4" "1,2,3,4" "$N_DATA" "$DELAY_SHORT"
run_group "M5" "5" "$N_FIXED" "$DELAY_SHORT"
run_group "M6" "6" "$N_FIXED" "$DELAY_SHORT"
run_group "M7" "7" "$N_FIXED" "$DELAY_SHORT"
run_group "M8to9" "8,9" "$N_ATORED" "$DELAY_SHORT"
run_group "M11_parreps" "11" "$N_PARREPS" "$DELAY_SHORT"

echo "" | tee -a "$OUTFILE"
echo "All COSMA5 OpenACC benchmark groups completed." | tee -a "$OUTFILE"
echo "Results saved under $OUTDIR" | tee -a "$OUTFILE"
