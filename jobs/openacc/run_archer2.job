#!/bin/bash
#SBATCH --account=d35-wt
#SBATCH --job-name=ar2_openacc
#SBATCH --time=4:00:00
#SBATCH --nodes=1
#SBATCH --partition=gpu
#SBATCH --qos=gpu-exc
#SBATCH --gres=gpu:1
#SBATCH --exclusive
#SBATCH --output=result/Archer2_Output/Logs/%x_%j.out

set -e

module load PrgEnv-amd
module load craype-accel-amd-gfx90a
module load craype-x86-milan

mkdir -p result/Archer2_Output/Logs
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/../common.sh"

MACHINE="MI210"
API="OpenACC"
COMPILER_TAG=$(compiler_tag_cray)
OUTDIR="result/$MACHINE/$API/$COMPILER_TAG"
mkdir -p "$OUTDIR"

JOB_NAME="ar2_openacc"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="$OUTDIR/${JOB_NAME}_${TIMESTAMP}.out"

GANGS=104
WORKERS=64

N_DATA="1,4,16,64,256,1024,4096,16384,65536,262144,1048576,4194304,16777216"
N_ATORED="1,4,16,64"
N_FIXED="16384"
N_PARREPS="1,2,4,8,16,32,64,128"

DELAY_SHORT="1,8096"
PLOT_PY="${PLOT_PY:-/work/d35/d35/weiyu24/Microbenchmarking-of-Accelerators-Offloading/microbenchmark/.plotenv/bin/python}"

echo "Running Archer2 MI210 OpenACC benchmark groups..." | tee "$OUTFILE"
echo "GANGS=$GANGS WORKERS=$WORKERS" | tee -a "$OUTFILE"
echo "N_DATA=$N_DATA" | tee -a "$OUTFILE"
echo "N_ATORED=$N_ATORED" | tee -a "$OUTFILE"
echo "N_FIXED=$N_FIXED" | tee -a "$OUTFILE"
echo "DELAY_SHORT=$DELAY_SHORT" | tee -a "$OUTFILE"

echo "Compiling OpenACC backend with Cray CCE..." | tee -a "$OUTFILE"
make clean
make openacc-distribution OPENACC_DEFS=Makefile.defs.openacc.cray

plot_group () {
    local BASE="$1"
    local SCALE="$2"
    local CSV="$OUTDIR/distribution_${BASE}.csv"
    local TXT="$OUTDIR/overhead_${BASE}.txt"
    local PNG="$OUTDIR/resultLowest_${BASE}.png"

    if [ -f "$CSV" ] && [ -f "$TXT" ] && [ -x "$PLOT_PY" ]; then
        "$PLOT_PY" ./plots/plot_raw_times.py "$CSV" "$TXT" 1,18 "$SCALE" "$PNG" 2>&1 | tee -a "$OUTFILE"
    else
        echo "Plot skipped for $BASE." | tee -a "$OUTFILE"
    fi
}

run_group () {
    local TAG="$1"
    local METHODS="$2"
    local NLIST="$3"
    local DELAY_RANGE="$4"
    local SCALE="${5:-lin}"

    local SAFE_DELAY="${DELAY_RANGE//,/to}"
    local BASE="${TAG}_${SAFE_DELAY}_${TIMESTAMP}"

    echo "" | tee -a "$OUTFILE"
    echo "===== [$TAG] Method=$METHODS N=$NLIST Delay=$DELAY_RANGE =====" | tee -a "$OUTFILE"

    rm -f overhead_distribution.txt raw_times.csv

    srun ./bin/microbenchmark API=openacc \
        Method="$METHODS" \
        N="$NLIST" \
        Delay="$DELAY_RANGE" \
        gang_count="$GANGS" \
        worker_count="$WORKERS" \
        | tee -a "$OUTFILE"

    if [ -f overhead_distribution.txt ]; then
        mv overhead_distribution.txt "$OUTDIR/overhead_${BASE}.txt"
    fi

    if [ -f raw_times.csv ]; then
        mv raw_times.csv "$OUTDIR/distribution_${BASE}.csv"
    fi

    plot_group "$BASE" "$SCALE"
}

run_group "M0_M10" "0,10" "$N_FIXED" "$DELAY_SHORT"
run_group "M1to4" "1,2,3,4" "$N_DATA" "$DELAY_SHORT"
run_group "M5" "5" "$N_FIXED" "$DELAY_SHORT"
run_group "M6" "6" "$N_FIXED" "$DELAY_SHORT"
run_group "M7" "7" "$N_FIXED" "$DELAY_SHORT"
run_group "M8to9" "8,9" "$N_ATORED" "$DELAY_SHORT"
run_group "M11_parreps" "11" "$N_PARREPS" "$DELAY_SHORT"

echo "" | tee -a "$OUTFILE"
echo "All Archer2 OpenACC benchmark groups completed." | tee -a "$OUTFILE"
echo "Results saved under $OUTDIR" | tee -a "$OUTFILE"
