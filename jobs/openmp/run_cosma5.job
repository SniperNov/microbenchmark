#!/bin/bash -l
#SBATCH -J cosma5_omp
#SBATCH -o result/COSMA5_Output/Logs/%x_%j.out
#SBATCH -p mi300x
#SBATCH -A do018
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=96
#SBATCH --gres=gpu:1
#SBATCH --exclusive
#SBATCH -t 04:00:00

set -e

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export OMP_TARGET_OFFLOAD=mandatory

cd /cosma/home/do018/dc-tu2/microbenchmark

export PATH="$HOME/bin:$PATH"

module purge

make clean
make openmp-distribution

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/../common.sh"

MACHINE="MI300X"
API="OpenMP"
COMPILER_TAG=$(compiler_tag_amdclang)
OUTDIR="result/$MACHINE/$API/$COMPILER_TAG"
mkdir -p "$OUTDIR"
mkdir -p "result/COSMA5_Output/Logs"

JOB_NAME="cosma5_omp"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="$OUTDIR/${JOB_NAME}_${TIMESTAMP}.out"

echo "Running COSMA5 MI300X OpenMP benchmark groups..." | tee "$OUTFILE"

# =========================================
# Machine-specific configuration: COSMA5 MI300X
# =========================================
THREADS=64
TEAMS=304

# =========================================
# Experiment configuration
# Same logical structure as Archer2 and GH
# =========================================
N_DATA="1,4,16,64,256,1024,4096,16384,65536,262144,1048576,4194304,16777216"
N_ATORED="1,2,4,8,16,32,64"
N_FIXED="16384"

DELAY_SHORT="1,8096"

PLOT_PY="/cosma/home/do018/dc-tu2/microbenchmark/.venv/bin/python"

run_group () {
    local TAG="$1"
    local METHODS="$2"
    local NLIST="$3"
    local DELAY_RANGE="$4"

    local SAFE_DELAY="${DELAY_RANGE//,/to}"
    local BASE="${TAG}_${SAFE_DELAY}_${TIMESTAMP}"

    echo "" | tee -a "$OUTFILE"
    echo "===== [$TAG] Method=$METHODS N=$NLIST Delay=$DELAY_RANGE =====" | tee -a "$OUTFILE"
    echo "THREADS=$THREADS TEAMS=$TEAMS" | tee -a "$OUTFILE"

    srun ./bin/microbenchmark API=openmp \
        Method="$METHODS" \
        N="$NLIST" \
        Delay="$DELAY_RANGE" \
        thread_count="$THREADS" \
        team_count="$TEAMS" \
        | tee -a "$OUTFILE"

    if [ -f overhead_distribution.txt ]; then
        mv overhead_distribution.txt "$OUTDIR/overhead_${BASE}.txt"
    fi

    if [ -f raw_times.csv ]; then
        mv raw_times.csv "$OUTDIR/distribution_${BASE}.csv"
    fi

    if [ -f "$OUTDIR/distribution_${BASE}.csv" ] && [ -f "$OUTDIR/overhead_${BASE}.txt" ]; then
        echo "Plotting $BASE ..." | tee -a "$OUTFILE"

        "$PLOT_PY" ./plots/plot_raw_times.py \
            "$OUTDIR/distribution_${BASE}.csv" \
            "$OUTDIR/overhead_${BASE}.txt" \
            1,18 lin \
            "$OUTDIR/resultLowest_${BASE}.png" 2>&1 | tee -a "$OUTFILE"
    else
        echo "Plot skipped for $BASE because csv/txt missing." | tee -a "$OUTFILE"
    fi
}
# =========================================
# Group 0: method 0 / 10, fixed N
# =========================================
run_group "M0_M10" "0,10" "$N_FIXED" "$DELAY_SHORT"


# =========================================
# Group 1: methods 1-4, data size sweep
# =========================================
run_group "M1to4" "1,2,3,4" "$N_DATA"   "$DELAY_SHORT"


# =========================================
# Group 2: methods 5 / 6 / 7, fixed N
# =========================================
run_group "M5"    "5"       "$N_FIXED"  "$DELAY_SHORT"

run_group "M6"    "6"       "$N_FIXED"  "$DELAY_SHORT"

run_group "M7"    "7"       "$N_FIXED"  "$DELAY_SHORT"

# =========================================
# Group 3: methods 8 / 9, atomic + reduction
# =========================================
run_group "M8to9" "8,9"     "$N_ATORED" "$DELAY_SHORT"

# =========================================
# Group 4: method 11, N is parreps
# =========================================
N_PARREPS="1,2,4,8,16,32,64,128"

run_group "M11_parreps" "11" "$N_PARREPS" "$DELAY_SHORT"

echo "" | tee -a "$OUTFILE"
echo "All COSMA5 MI300X benchmark groups completed." | tee -a "$OUTFILE"
echo "Results saved under $OUTDIR" | tee -a "$OUTFILE"