#!/bin/bash -l
#SBATCH --job-name=run_eidf_h200_cuda
#SBATCH --time=04:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --exclusive
#SBATCH --output=slurm-%x-%j.out

# EIDF H200 CUDA Slurm job.

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:?Submit from repository root}"
export CUDA_MACHINE=H200
exec bash jobs/cuda/run_suite.sh
