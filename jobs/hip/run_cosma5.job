#!/bin/bash -l
#SBATCH -J cosma5_hip
#SBATCH --output=slurm-%x-%j.out
#SBATCH -p mi300x
#SBATCH -A do018
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=96
#SBATCH --gres=gpu:1
#SBATCH --exclusive
#SBATCH -t 04:00:00
set -euo pipefail
cd "${SLURM_SUBMIT_DIR:?Submit from the repository root}"
# Use the site's existing ROCm environment; no module names are assumed.
export HIP_MACHINE=MI300X
export HIP_ARCH="${HIP_ARCH:-gfx942}"
bash jobs/hip/run_AMD.sh
