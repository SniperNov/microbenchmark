Compile:
```
CC=amdclang
CFLAGS= -O0 -fopenmp -fopenmp-targets=amdgcn-amd-amdhsa -Xopenmp-target=amdgcn-amd-amdhsa -march=gfx950
LDFLAGS = -fopenmp
CPPFLAGS = -E -O0
LIBS = -lm
```
 
Run.sh
```
#!/bin/bash
OUTDIR="MBResult_A/Mi355X_Output"
mkdir -p "$OUTDIR"
 
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTFILE="$OUTDIR/run_${TIMESTAMP}.out"
 
./microbenchmark_distribution Method=1,2,3,4 N=1,4,16,64,256,1024,4096,16384,65536,262144,1048576,4194304,16777216 Delay=8192 thread_count=64 team_count=256 | tee $OUTFILE
mv overhead_distribution.txt $OUTDIR/overhead_$TIMESTAMP.txt
```
 
